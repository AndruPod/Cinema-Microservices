# Copy to .env and adjust. Values below are for running the services on your
# machine (npm run start:dev). docker-compose.yaml overrides hostnames and the
# internal database port for containers, so the same file works for both.

# --- PostgreSQL -------------------------------------------------------------
DB_HOST=localhost
# Host port. docker compose publishes PostgreSQL on this port as well.
DB_PORT=5432
DB_USER=cinema
DB_PASSWORD=change-me

# One database per service
USERS_DB_NAME=users_db
CATALOG_DB_NAME=catalog_db
ORDER_DB_NAME=order_db

# --- API gateway ------------------------------------------------------------
API_GATEWAY_PORT=3000
# Timeout for every gateway -> service and order -> catalog call
RPC_TIMEOUT_MS=5000

# --- Microservices (TCP) ------------------------------------------------------
# *_HOST: address clients connect to; *_LISTEN_HOST: interface the service binds
AUTH_SERVICE_HOST=localhost
AUTH_SERVICE_LISTEN_HOST=0.0.0.0
AUTH_SERVICE_PORT=3003

CATALOG_SERVICE_HOST=localhost
CATALOG_SERVICE_LISTEN_HOST=0.0.0.0
CATALOG_SERVICE_PORT=3001

ORDER_SERVICE_HOST=localhost
ORDER_SERVICE_LISTEN_HOST=0.0.0.0
ORDER_SERVICE_PORT=3002

# --- Authentication -----------------------------------------------------------
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-of-32-plus-chars
JWT_EXPIRES_IN=1h

# Optional: an ADMIN account created on first start (required to manage movies).
# Leave ADMIN_EMAIL empty to skip.
ADMIN_EMAIL=admin@cinema.local
ADMIN_PASSWORD=change-me-admin
